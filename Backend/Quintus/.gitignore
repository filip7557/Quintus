## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build Folders
bin/
obj/
Debug/
Release/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Auto-generated files
*.generated.cs
*.g.cs
*.designer.cs

# Visual Studio Code
.vscode/
.vs

# Rider IDE
.idea/
*.sln.iml

# ASP.NET temporary files
App_Data/
App_Code/
*.log

# NuGet packages
*.nupkg
*.snupkg
packages/
.nuget/

# Visual Studio cache
*.VC.db
*.VC.opendb

# Publish output
publish/
*.publish.xml

# Resharper
_ReSharper*/
*.ReSharper

# DotCover
*.dotCover

# MSTest / NUnit / xUnit Test Results
TestResults/
*.trx
*.TestResults/

# Entity Framework / database files
*.mdf
*.ldf

# Dotnet tools
.dotnet/
global.json

# Rider
.idea/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

.env
